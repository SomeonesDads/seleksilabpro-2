# App A runtime environment (copy to applications/app-a/.env)
APP_PORT=5010
DATABASE_URL=postgres://appa:appa@postgres-app-a:5432/appa?sslmode=disable
AUTH_PROVIDER_BASE_URL=http://auth-server:5001
APP_CLIENT_ID=app-a-client
APP_CLIENT_SECRET=change-me-app-a-secret
APP_REDIRECT_URI=http://app-a:5010/auth/callback
INTERNAL_AUTH_TOKEN=change-me-internal-app-a
APP_SESSION_TTL=12h
COOKIE_SECURE=false
# APP_ID is informational; the local database belongs solely to App A.
APP_ID=00000000-0000-0000-0000-0000000000a1

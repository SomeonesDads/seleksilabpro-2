# App B runtime environment (copy to applications/app-b/.env)
APP_PORT=5020
DATABASE_URL=postgres://appb:appb@postgres-app-b:5432/appb?sslmode=disable
AUTH_PROVIDER_BASE_URL=http://auth-server:5001
APP_CLIENT_ID=app-b-client
APP_CLIENT_SECRET=
APP_REDIRECT_URI=http://app-b:5020/auth/callback
INTERNAL_AUTH_TOKEN=
APP_SESSION_TTL=12h
COOKIE_SECURE=false
# APP_ID is informational; the local database belongs solely to App B.
APP_ID=00000000-0000-0000-0000-0000000000b2

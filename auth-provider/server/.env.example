# Copy to .env (same directory) and fill in real values.
# .env itself is gitignored — never commit actual secrets.

PORT=5001
DATABASE_URL=postgres://authprovider:authprovider@postgres-primary:5432/authprovider?sslmode=disable
BROKER_URL=amqp://guest:guest@rabbitmq:5672/

# "opaque" or "jwt" — document your choice + tradeoffs in the root README.
TOKEN_STRATEGY=jwt
# Only required if TOKEN_STRATEGY=jwt. Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=
JWT_ISSUER=auth-provider

# Base64-encoded 32-byte AES-GCM key used to encrypt TOTP secrets at rest.
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

AUTH_CODE_TTL=3m
ACCESS_TOKEN_TTL=15m
SSO_SESSION_TTL=12h
SHUTDOWN_TIMEOUT=10s

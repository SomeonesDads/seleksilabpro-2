DATABASE_URL=postgres://authprovider:authprovider@postgres-primary:5432/authprovider?sslmode=disable
BROKER_URL=amqp://guest:guest@rabbitmq:5672/
MAX_RETRIES=5
BASE_BACKOFF=2s
MAX_BACKOFF=2m
OUTBOX_INTERVAL=500ms
SHUTDOWN_TIMEOUT=10s

# JSON array of active application targets. Internal auth uses X-Internal-Auth.
# Set tokens to the same values as the relying applications and seed config.
APP_TARGETS_JSON=

DATABASE_URL=postgres://authprovider:authprovider@postgres-primary:5432/authprovider?sslmode=disable
BROKER_URL=amqp://guest:guest@rabbitmq:5672/
MAX_RETRIES=5
BASE_BACKOFF=2s
MAX_BACKOFF=2m
OUTBOX_INTERVAL=500ms
SHUTDOWN_TIMEOUT=10s

# JSON array of active application targets. Internal auth uses X-Internal-Auth.
# Application IDs and tokens match the rows created by `go run ./cmd/seed`
# (see auth-provider/server/cmd/seed and the app .env.example files).
# APP_TARGETS_JSON=[{"name":"App A","applicationId":"00000000-0000-0000-0000-0000000000a1","logoutNotifyURL":"http://app-a:5010/internal/logout","internalAuthToken":"change-me-internal-app-a"},{"name":"App B","applicationId":"00000000-0000-0000-0000-0000000000b2","logoutNotifyURL":"http://app-b:5020/internal/logout","internalAuthToken":"change-me-internal-app-b"}]
